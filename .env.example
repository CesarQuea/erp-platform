ERP_ENV=local
APP_NAME=ERP Platform API
LOG_LEVEL=INFO
TENANT_ENGINE_CACHE_SIZE=32
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=erp-platform
JWT_AUDIENCE=erp-first-party
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<platform_database>
# JWT_SIGNING_SECRET=<at-least-32-random-bytes-from-secret-manager>
# TENANT_DATABASES_JSON={"11111111-1111-1111-1111-111111111111":{"database_url":"postgresql://<user>:<password>@<host>:5432/<tenant_database>","active":true}}
